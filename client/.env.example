# ------------------------------------------------------------------
# Kindora client — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ------------------------------------------------------------------

# Where the Next.js /api proxy forwards browser requests.
# Local development (Express API running on port 5000):
API_PROXY_TARGET=http://127.0.0.1:5000
# Production (your deployed API), e.g.:
# API_PROXY_TARGET=https://kindora-api.onrender.com

# NOTE: The browser only ever calls relative `/api/...` URLs on the Next.js
# origin. No API secret or backend URL is exposed to client-side code.
