# ------------------------------------------------------------------
# Kindora API — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# MongoDB Atlas connection string (production)
# Local development against the bundled dev database:
#   mongodb://127.0.0.1:27017/kindora?directConnection=true
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=kindora

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
# Public URL of the CLIENT (cookies are issued for the client origin via the
# Next.js /api proxy in development; in production set this to the API's public URL)
BETTER_AUTH_URL=http://localhost:3000

# The public origin of the frontend (CORS + trusted origins)
CLIENT_ORIGIN=http://localhost:3000

# Google OAuth (optional — the Google button is hidden until both are set)
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <API origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API port (local development)
PORT=5000

# Set to "true" only when you intentionally want `npm run seed -- --reset`
# to wipe demo data in this database.
ALLOW_SEED_RESET=false
